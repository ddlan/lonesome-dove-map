  "author": "Larry McMurtry",
  "chapters": 102,
  "parts": [[1, 1], [2, 26], [3, 75]],

  "epub": {
    "_note": "Regex for the EPUB's chapter files; group 1 is the chapter number, in reading order.",
    "chapter_file": "ch(\\d{3})\\.html$"
  },

  "wording": {
    "jump_confirm": "Ride ahead to chapter {n}? This shows places past chapter {furthest}, the furthest you've marked.",
    "jump_yes": "Ride ahead",
    "jump_no": "Stay put"
